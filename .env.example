# Stable image versions (verified 2026-08-09)
MYSQL_VERSION=8.4.10
KAFKA_VERSION=4.3.1
STARROCKS_VERSION=4.0.13
DOLPHINSCHEDULER_VERSION=3.4.1
DOLPHINSCHEDULER_POSTGRES_VERSION=16.14-bookworm
DOLPHINSCHEDULER_ZOOKEEPER_VERSION=3.8.4

# Local development credentials
MYSQL_ROOT_PASSWORD=dev_root_password
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=dev_app_password
DOLPHINSCHEDULER_DB_NAME=dolphinscheduler
DOLPHINSCHEDULER_DB_USER=dolphinscheduler
DOLPHINSCHEDULER_DB_PASSWORD=dev_dolphinscheduler_password

# Host ports
MYSQL_PORT=3306
KAFKA_PORT=9092
STARROCKS_SQL_PORT=9030
STARROCKS_FE_HTTP_PORT=8030
STARROCKS_BE_HTTP_PORT=8040
DOLPHINSCHEDULER_API_PORT=12345
DOLPHINSCHEDULER_PYTHON_GATEWAY_PORT=25333

# Single-node Kafka KRaft cluster ID. Change it only before the first startup.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Docker resource limits
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPUS=2.0
KAFKA_MEMORY_LIMIT=2g
KAFKA_CPUS=2.0
STARROCKS_MEMORY_LIMIT=8g
STARROCKS_CPUS=4.0
DOLPHINSCHEDULER_POSTGRES_MEMORY_LIMIT=768m
DOLPHINSCHEDULER_POSTGRES_CPUS=1.0
DOLPHINSCHEDULER_ZOOKEEPER_MEMORY_LIMIT=512m
DOLPHINSCHEDULER_ZOOKEEPER_CPUS=0.5
DOLPHINSCHEDULER_SCHEMA_MEMORY_LIMIT=1g
DOLPHINSCHEDULER_SCHEMA_CPUS=1.0
DOLPHINSCHEDULER_API_MEMORY_LIMIT=1280m
DOLPHINSCHEDULER_API_CPUS=1.0
DOLPHINSCHEDULER_ALERT_MEMORY_LIMIT=1g
DOLPHINSCHEDULER_ALERT_CPUS=0.5
DOLPHINSCHEDULER_MASTER_MEMORY_LIMIT=2g
DOLPHINSCHEDULER_MASTER_CPUS=1.0
DOLPHINSCHEDULER_WORKER_MEMORY_LIMIT=2g
DOLPHINSCHEDULER_WORKER_CPUS=1.5

TZ=Asia/Shanghai

# Sentinel FastAPI (copy to .env; never commit real secrets)
DATABASE_URL=mysql+pymysql://app:dev_app_password@127.0.0.1:3306/app?charset=utf8mb4
DATASOURCE_ENCRYPTION_KEY=generate-with-backend-scripts-bootstrap-env
SESSION_SECRET=generate-with-backend-scripts-bootstrap-env
# Canonical shared token used by both FastAPI and the long-connection gateway.
SENTINEL_INTERNAL_TOKEN=generate-with-backend-scripts-bootstrap-env
AUTO_LOGIN=false
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=Admin@123456
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Card deep-link origin. Use a recipient-reachable HTTPS URL outside local-only development.
SENTINEL_PUBLIC_BASE_URL=http://localhost:8000
# Long-connection process -> FastAPI origin; loopback is valid when both run on one host.
SENTINEL_API_BASE_URL=http://127.0.0.1:8000
VALIDATION_TIMEOUT_SCAN_INTERVAL_SECONDS=60
VALIDATION_MAINTENANCE_BATCH_SIZE=50
FEISHU_HTTP_TIMEOUT_SECONDS=10
DOLPHINSCHEDULER_URL=http://localhost:12345/dolphinscheduler
DOLPHINSCHEDULER_USERNAME=admin
DOLPHINSCHEDULER_PASSWORD=dolphinscheduler123
DOLPHINSCHEDULER_TENANT=default
DOLPHINSCHEDULER_PROJECT=sentinel-mvp
TIMEZONE=Asia/Shanghai
RECONCILE_ON_STARTUP=true

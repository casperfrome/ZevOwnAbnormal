    <resources>
      <resource><directory>${upstream}/flink-connector-kafka/src/main/resources</directory></resource>
      <resource><directory>${upstream}</directory><includes><include>LICENSE</include><include>NOTICE</include></includes><targetPath>META-INF</targetPath></resource>
